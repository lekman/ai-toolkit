{
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git -c core.hooksPath=*)",
      "Bash(git config core.hooksPath:*)"
    ],
    "ask": [
      "Edit(commitlint.config.mjs)",
      "Edit(.trunk/trunk.yaml)",
      "Edit(.trunk/configs/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-verify-guard.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tripwire.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
