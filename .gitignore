# Override the global gitignore (~/.gitignore_global ignores CLAUDE.md).
# In this repo, CLAUDE.md files are shareable content, so track them.
!CLAUDE.md

# Override the global ignore of .trunk/ so the shared config is tracked.
# .trunk/.gitignore still excludes the local cache/symlinks (out, logs,
# plugins, tools, actions, notifications, user.yaml).
!.trunk/

# Override the global ignore of .claude/ so the repo-level config is shared
# (PreToolUse hooks, rules, settings.json). Keep personal local overrides out.
!.claude/
.claude/settings.local.json

# Bun workspaces: one node_modules and lockfile at the root.
node_modules/

# Local planning documents — working notes with personal architecture detail.
# Committed, generalised content derived from these lives in practices/.
docs/plans/

# Per-package build output and generated licences. Each package also carries its
# own .gitignore, but that only exists on branches where the package does — so a
# branch without it would otherwise track another branch's build artifacts.
packages/*/dist/
packages/*/LICENSE
packages/rag/*/dist/
packages/rag/*/LICENSE

# RAG local runtime artifacts (qualification reports live in the storage dir,
# but keep any accidental local copies out).
packages/rag/local/qualification/

# Never commit local secrets. The RAG runtime reads ~/.rag/env, not a repo
# .env — this line is a guard against accidents, not an invitation.
.env
.env.*

# Names real clients — the leak it exists to prevent
scripts/client-terms.txt
