{
  "name": "@lekman/claude-foundry",
  "version": "0.1.0",
  "description": "Run one Claude Code session against Claude on Microsoft Foundry, without switching your global settings.",
  "license": "MIT",
  "author": "Tobias Lekman",
  "homepage": "https://github.com/lekman/ai-toolkit/tree/main/packages/claude-foundry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekman/ai-toolkit.git",
    "directory": "packages/claude-foundry"
  },
  "keywords": [
    "claude-code",
    "microsoft-foundry",
    "azure",
    "entra-id"
  ],
  "type": "module",
  "bin": {
    "claude-foundry": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "release": "bun run ../../scripts/release.ts",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.0"
  }
}
