{
  "name": "@lekman/claude-local",
  "version": "0.2.0",
  "description": "Run Claude Code against a local model on Apple Silicon, via LM Studio's Anthropic-compatible endpoint.",
  "license": "MIT",
  "author": "Tobias Lekman",
  "homepage": "https://github.com/lekman/ai-toolkit/tree/main/packages/claude-local",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekman/ai-toolkit.git",
    "directory": "packages/claude-local"
  },
  "keywords": [
    "claude-code",
    "lm-studio",
    "local-llm",
    "mlx",
    "apple-silicon"
  ],
  "type": "module",
  "bin": {
    "claude-local": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "release": "bun run scripts/release.ts",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.0"
  }
}
