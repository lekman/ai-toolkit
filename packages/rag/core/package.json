{
  "name": "@lekman/rag-core",
  "version": "0.1.0",
  "description": "RAG toolkit core: document model, chunking, stores, embeddings, indexer, and MCP servers.",
  "license": "MIT",
  "author": "Tobias Lekman",
  "homepage": "https://github.com/lekman/ai-toolkit/tree/main/packages/rag/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekman/ai-toolkit.git",
    "directory": "packages/rag/core"
  },
  "keywords": [
    "rag",
    "mcp",
    "lancedb",
    "obsidian",
    "retrieval"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "rag-indexer": "./dist/bin/rag-indexer.js",
    "rag-mcp": "./dist/bin/rag-mcp.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.33.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0"
  }
}
