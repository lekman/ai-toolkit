{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__plugin_tasks_tasks__task_complete",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/trace.ts\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__plugin_tasks_tasks__task_claim|mcp__plugin_tasks_tasks__task_add",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/trace.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
